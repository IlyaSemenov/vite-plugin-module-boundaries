  "author": "Ilya Semenov",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/vite-plugin-module-boundaries.git"
  },
  "homepage": "https://github.com/IlyaSemenov/vite-plugin-module-boundaries#readme",
  "bugs": "https://github.com/IlyaSemenov/vite-plugin-module-boundaries/issues",
  "exports": {
